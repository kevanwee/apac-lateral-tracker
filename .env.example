# Copy to .env for local work. Never commit .env.
# In production these live in GitHub Actions secrets and Vercel env vars.

# --- Database -------------------------------------------------------------
# Neon/Supabase pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct (non-pooled) connection — migrations only.
DATABASE_URL_DIRECT=postgresql://user:password@host/dbname?sslmode=require

# --- Ingestion politeness -------------------------------------------------
# Sent on every outbound HTTP request. MUST carry a reachable contact address.
TRACKER_USER_AGENT=apac-lateral-tracker/0.1 (+https://github.com/kevanwee/apac-lateral-tracker; contact: kevanwee@gmail.com)
# Hard floor between requests to the same source, seconds.
TRACKER_MIN_REQUEST_INTERVAL_SECONDS=10

# --- LLM ------------------------------------------------------------------
ANTHROPIC_API_KEY=
TRACKER_EXTRACTION_MODEL=claude-opus-5
# Run aborts loudly when projected spend exceeds this. No silent truncation.
TRACKER_LLM_COST_CEILING_USD_PER_RUN=5.00

# --- Alerting -------------------------------------------------------------
# Fired when a source yields zero items for 3 consecutive runs.
TRACKER_ALERT_WEBHOOK_URL=
