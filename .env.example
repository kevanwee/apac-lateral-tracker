# Copy to .env for local work. Never commit .env.
# In production these live in GitHub Actions secrets and Vercel env vars.

# --- Database -------------------------------------------------------------
# Neon/Supabase pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct (non-pooled) connection — migrations only.
DATABASE_URL_DIRECT=postgresql://user:password@host/dbname?sslmode=require

# The database `pytest` is allowed to DESTROY. The suite drops and recreates
# the `public` schema on every run, so this must never be the database above.
#
# tests/conftest.py enforces that rather than trusting it: a remote database
# is accepted only when its name ends with `_test` and it is not the database
# DATABASE_URL points at. A local host is accepted whatever the name.
#
# A separate database on the same managed project is fine — create it once
# with `CREATE DATABASE tracker_test` over the direct (non-pooled) endpoint,
# since a pooled endpoint will not run it.
TRACKER_TEST_DATABASE_URL=postgresql://user:password@host/tracker_test?sslmode=require

# --- Ingestion politeness -------------------------------------------------
# Sent on every outbound HTTP request. MUST carry a reachable contact address.
TRACKER_USER_AGENT=apac-lateral-tracker/0.1 (+https://github.com/kevanwee/apac-lateral-tracker; contact: kevanwee@gmail.com)
# Hard floor between requests to the same source, seconds.
TRACKER_MIN_REQUEST_INTERVAL_SECONDS=10

# --- LLM ------------------------------------------------------------------
ANTHROPIC_API_KEY=
TRACKER_EXTRACTION_MODEL=claude-opus-5
# Run aborts loudly when projected spend exceeds this. No silent truncation.
TRACKER_LLM_COST_CEILING_USD_PER_RUN=5.00

# --- Newsletter ingestion (IMAP) ------------------------------------------
# The lawful-access route to outlets that block crawlers: read the newsletter
# they send you. The adapter opens ONE named folder, READ-ONLY, filtered to a
# sender allowlist. It never touches the rest of the mailbox and has no code
# path that writes, moves or deletes.
#
# Use an app-specific password, never your account password. A dedicated
# address that receives only these newsletters is better still.
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Alerting -------------------------------------------------------------
# Fired when a source yields zero items for 3 consecutive runs.
TRACKER_ALERT_WEBHOOK_URL=
